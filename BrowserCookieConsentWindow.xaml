<Window x:Class="EhGalleryDownloader.BrowserCookieConsentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="导入浏览器登录状态" Width="540" Height="510"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Background="#F5F7FB">
    <Grid Margin="22">
        <Border Background="White" BorderBrush="#E4E9F2" BorderThickness="1" CornerRadius="16" Padding="28">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Border Width="48" Height="48" Background="#E8F0FF" CornerRadius="14">
                        <TextBlock Text="✓" FontSize="24" FontWeight="Bold" Foreground="#2563EB"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="15,1,0,0">
                        <TextBlock Text="允许导入当前网页的登录状态？" FontSize="19" FontWeight="SemiBold"/>
                        <TextBlock Text="需要配套浏览器扩展，只在你点击扩展时读取" FontSize="{DynamicResource FontCaptionSize}"
                                   Foreground="{StaticResource SubTextBrush}" Margin="0,6,0,0"/>
                    </StackPanel>
                </StackPanel>

                <Border Grid.Row="1" Margin="0,22,0,15" Padding="16,13" Background="#F0F6FF" CornerRadius="10">
                    <TextBlock Text="软件会开启一个两分钟有效的一次性本机通道。Cookie 不会上传到互联网。"
                               TextWrapping="Wrap" Foreground="#2B579A" LineHeight="20"/>
                </Border>

                <StackPanel Grid.Row="2">
                    <TextBlock Text="本次允许的范围" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <TextBlock Text="●  仅限当前打开的 E-Hentai / ExHentai 网页" Margin="2,0,0,10"/>
                    <TextBlock Text="●  仅读取 ipb_member_id、ipb_pass_hash、igneous" Margin="2,0,0,10"/>
                    <TextBlock Text="●  不读取保存的密码、浏览记录和其他网站数据" Margin="2,0,0,10"/>
                    <TextBlock Text="●  验证成功后使用当前 Windows 账户加密保存" Margin="2,0,0,10"/>
                    <Border Background="#FFF8E8" CornerRadius="9" Padding="13,10" Margin="0,8,0,0">
                        <TextBlock Text="接下来请保持目标网页打开，然后点击浏览器工具栏中的“画廊登录导入”扩展。"
                                   Foreground="#8A5A08" TextWrapping="Wrap" LineHeight="19"/>
                    </Border>
                </StackPanel>

                <Grid Grid.Row="3" Margin="0,22,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Button Grid.Column="1" Content="取消" Width="92" Margin="0,0,10,0" IsCancel="True"/>
                    <Button Grid.Column="2" Content="允许并开始" Width="126" Style="{StaticResource PrimaryButton}"
                            IsDefault="True" Click="AllowButton_Click"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
