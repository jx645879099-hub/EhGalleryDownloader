<Window x:Class="EhGalleryDownloader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="画廊下载助手" Height="960" Width="1360"
        MinHeight="720" MinWidth="1080"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="2,0,2,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="画廊下载助手" FontSize="27" FontWeight="Bold"/>
                <TextBlock Margin="0,5,0,0" Foreground="{StaticResource SubTextBrush}"
                           Text="中文外壳 · gallery-dl 下载内核 · 自动经 Clash 下载 · 关闭后下次可继续"/>
            </StackPanel>
            <Border Grid.Column="1" Background="White" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="20" Padding="16,9">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="EngineDot" Width="9" Height="9" Fill="{StaticResource WarningBrush}" Margin="0,0,8,0"/>
                    <TextBlock x:Name="EngineStatusText" Text="正在检查内核…" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button x:Name="InstallEngineButton" Content="检查更新" Margin="14,-4,-8,-4"
                            Padding="10,4" MinHeight="28" Click="InstallEngineButton_Click"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="9" Padding="16" Margin="0,0,0,13">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Label Grid.Row="0" Content="画廊链接（支持一次粘贴一条；结束后可继续粘贴下一条）"/>
                <TextBox x:Name="UrlTextBox" Grid.Row="1" AcceptsReturn="True" Height="58"
                         VerticalContentAlignment="Center" FontSize="15"
                         ToolTip="例如：https://e-hentai.org/g/数字/令牌/"/>
                <Button Grid.Row="1" Grid.Column="1" Content="粘贴" Width="88" Margin="10,0,0,0"
                        Click="PasteButton_Click"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="9" Padding="16" Margin="0,0,0,13">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.7*"/>
                    <ColumnDefinition Width="1.05*"/>
                    <ColumnDefinition Width="0.95*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Label Grid.Row="0" Grid.Column="0" Content="保存位置"/>
                <Label Grid.Row="0" Grid.Column="1" Content="登录方式"/>
                <Label Grid.Row="0" Grid.Column="2" Content="图片质量"/>

                <Grid Grid.Row="1" Grid.Column="0" Margin="0,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="OutputPathTextBox"/>
                    <Button Grid.Column="1" Content="选择…" Margin="8,0,0,0" Padding="12,7" Click="BrowseButton_Click"/>
                </Grid>

                <ComboBox x:Name="LoginModeComboBox" Grid.Row="1" Grid.Column="1" Margin="0,0,12,0"
                          SelectionChanged="LoginModeComboBox_SelectionChanged">
                    <ComboBoxItem Content="手动粘贴 Cookie（推荐）" Tag="manual"/>
                    <ComboBoxItem Content="从已关闭的 Edge 读取" Tag="edge"/>
                    <ComboBoxItem Content="从已关闭的 Chrome 读取" Tag="chrome"/>
                    <ComboBoxItem Content="从已关闭的 Firefox 读取" Tag="firefox"/>
                    <ComboBoxItem Content="不登录（仅公开画廊）" Tag="none"/>
                </ComboBox>

                <ComboBox x:Name="QualityComboBox" Grid.Row="1" Grid.Column="2" Margin="0,0,12,0">
                    <ComboBoxItem Content="原图（清晰，流量较多）" Tag="original"/>
                    <ComboBoxItem Content="网站压缩图（更省流量）" Tag="resized"/>
                </ComboBox>

                <Button x:Name="StartButton" Grid.Row="1" Grid.Column="3" Content="开始下载"
                        Width="125" Style="{StaticResource PrimaryButton}" Click="StartButton_Click"/>

                <WrapPanel Grid.Row="2" Grid.ColumnSpan="4" Margin="0,15,0,0">
                    <CheckBox x:Name="UseProxyCheckBox" Content="使用 Clash 代理" IsChecked="True"/>
                    <TextBox x:Name="ProxyTextBox" Width="190" Margin="8,0,10,0" Text="http://127.0.0.1:7897"/>
                    <CheckBox x:Name="AutoDetectProxyCheckBox"
                              Content="自动识别端口（推荐）" IsChecked="True"
                              Margin="0,0,10,0"
                              Checked="AutoDetectProxyCheckBox_Changed"
                              Unchecked="AutoDetectProxyCheckBox_Changed"
                              ToolTip="从 Clash Verge 的 Mihomo 控制接口读取当前 mixed-port；失败时保留手动地址。"/>
                    <TextBlock x:Name="ProxyDetectionStatusText"
                               VerticalAlignment="Center" Margin="0,0,22,0"
                               Foreground="{StaticResource SubTextBrush}"
                               Text="等待识别"/>
                    <CheckBox x:Name="ForceIpv4CheckBox" Content="优先 IPv4（更稳）" IsChecked="True" Margin="0,0,22,0"/>
                    <CheckBox x:Name="MetadataCheckBox" Content="保存画廊信息" IsChecked="True" Margin="0,0,22,0"/>
                    <CheckBox x:Name="CbzCheckBox" Content="打包为 CBZ（适合漫画阅读器）"/>
                    <Button x:Name="OpenNodeTestButton" Content="为当前画廊挑节点"
                            Margin="24,-5,0,-5" Padding="13,5"
                            Click="OpenNodeTestButton_Click"/>
                </WrapPanel>

                <Border x:Name="ManualCookiePanel" Grid.Row="3" Grid.ColumnSpan="4"
                        Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,13,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.ColumnSpan="4" Margin="0,0,0,7"
                                   Foreground="{StaticResource SubTextBrush}"
                                   Text="登录 Cookie：粘贴 Chrome 开发者工具 Request Headers 中 Cookie: 后面的完整内容。Cookie 等同临时密码，请勿发给别人。"/>

                        <Grid Grid.Row="1">
                            <PasswordBox x:Name="CookiePasswordBox" PasswordChar="●"
                                         PasswordChanged="CookiePasswordBox_PasswordChanged"
                                         ToolTip="支持直接粘贴 name=value; name2=value2"/>
                            <TextBox x:Name="CookieVisibleTextBox" Visibility="Collapsed"
                                     TextChanged="CookieVisibleTextBox_TextChanged"
                                     ToolTip="支持直接粘贴 name=value; name2=value2"/>
                        </Grid>
                        <Button x:Name="ToggleCookieButton" Grid.Row="1" Grid.Column="1"
                                Content="显示" Margin="8,0,0,0" Padding="12,7"
                                Click="ToggleCookieButton_Click"/>
                        <Button x:Name="VerifyCookieButton" Grid.Row="1" Grid.Column="2"
                                Content="验证登录" Margin="8,0,0,0" Padding="12,7"
                                Click="VerifyCookieButton_Click"/>
                        <Button Grid.Row="1" Grid.Column="3" Content="清除"
                                Margin="8,0,0,0" Padding="12,7"
                                Click="ClearCookieButton_Click"/>

                        <Grid Grid.Row="2" Grid.ColumnSpan="4" Margin="0,9,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="RememberCookieCheckBox"
                                      Content="自动加密保存（关闭或升级不会丢失）"
                                      Checked="RememberCookieCheckBox_Changed"
                                      Unchecked="RememberCookieCheckBox_Changed"/>
                            <TextBlock x:Name="CookieStatusText" Grid.Column="1"
                                       Margin="16,0,0,0" TextWrapping="Wrap"
                                       Foreground="{StaticResource SubTextBrush}"
                                       Text="尚未验证"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Border x:Name="NodeTestPanel" Grid.Row="3" Visibility="Collapsed"
                Background="White" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="9" Padding="14" Margin="0,0,0,13">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="150"/>
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="当前画廊节点实测" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock x:Name="NodeTestStatusText" Margin="0,4,0,0"
                                   Foreground="{StaticResource SubTextBrush}"
                                   Text="先排除断线节点，再真实读取当前画廊图片；稳定完整传输优先，速度其次。"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="收起" Padding="11,5" MinHeight="30"
                            Click="CloseNodeTestButton_Click"/>
                </Grid>

                <Grid Grid.Row="1" Margin="0,11,0,9">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="270"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="NodeGroupComboBox" DisplayMemberPath="Name"
                              SelectionChanged="NodeGroupComboBox_SelectionChanged"
                              ToolTip="选择实际控制画廊下载流量的策略组，通常是你平时手动切换节点的那一组。"/>
                    <TextBlock x:Name="NodeCandidateText" Grid.Column="1" Margin="12,0"
                               VerticalAlignment="Center" Foreground="{StaticResource SubTextBrush}"
                               Text="正在连接 Clash…"/>
                    <ComboBox x:Name="NodeTestModeComboBox" Grid.Column="2"
                              Width="175" Margin="0,0,8,0" SelectedIndex="0"
                              ToolTip="智能模式优先覆盖不同地区，只真实测速筛选后的约15个候选；完整模式真实测速所有通过快速筛选的节点。">
                        <ComboBoxItem Content="智能快速筛选（推荐）" Tag="smart"/>
                        <ComboBoxItem Content="检测全部可用节点" Tag="all"/>
                    </ComboBox>
                    <Button x:Name="QuickNodeTestButton" Grid.Column="3" Content="开始筛选测速"
                            IsEnabled="False" Margin="0,0,8,0" Padding="13,6"
                            Style="{StaticResource PrimaryButton}" Click="QuickNodeTestButton_Click"/>
                    <Button x:Name="PreciseNodeTestButton" Grid.Column="4" Content="精确复测前5名"
                            IsEnabled="False" Margin="0,0,8,0" Padding="13,6"
                            Click="PreciseNodeTestButton_Click"/>
                    <Button x:Name="StopNodeTestButton" Grid.Column="5" Content="停止测试"
                            IsEnabled="False" Margin="0,0,8,0" Padding="13,6"
                            Style="{StaticResource DangerButton}" Click="StopNodeTestButton_Click"/>
                    <Button x:Name="UseTestedNodeButton" Grid.Column="6" Content="使用选中节点"
                            IsEnabled="False" Padding="13,6" Click="UseTestedNodeButton_Click"/>
                </Grid>

                <DataGrid x:Name="NodeResultsGrid" Grid.Row="2"
                          ItemsSource="{Binding NodeResults}"
                          SelectionChanged="NodeResultsGrid_SelectionChanged"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding RankText}" Width="45"/>
                        <DataGridTextColumn Header="节点" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="类型" Binding="{Binding Type}" Width="105"/>
                        <DataGridTextColumn Header="Clash延迟" Binding="{Binding ClashDelayText}" Width="90"/>
                        <DataGridTextColumn Header="传输成功" Binding="{Binding SuccessText}" Width="95"/>
                        <DataGridTextColumn Header="中断" Binding="{Binding Interruptions}" Width="65"/>
                        <DataGridTextColumn Header="实际速度" Binding="{Binding SpeedText}" Width="110"/>
                        <DataGridTextColumn Header="测试流量" Binding="{Binding DownloadedText}" Width="95"/>
                        <DataGridTextColumn Header="评价" Binding="{Binding Rating}" Width="115"/>
                        <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="185"/>
                        <DataGridTextColumn Header="详细说明" Binding="{Binding Details}" Width="360"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Margin="2,0,2,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="下载任务" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="StopButton" Content="停止当前任务" Style="{StaticResource DangerButton}"
                            IsEnabled="False" Margin="0,0,8,0" Click="StopButton_Click"/>
                    <Button x:Name="RetryButton" Content="继续 / 补漏选中任务" IsEnabled="False"
                            Margin="0,0,8,0" Click="RetryButton_Click"/>
                    <Button Content="打开保存位置" Click="OpenFolderButton_Click"/>
                </StackPanel>
            </Grid>

            <DataGrid x:Name="JobsGrid" Grid.Row="1" ItemsSource="{Binding Jobs}"
                      SelectionChanged="JobsGrid_SelectionChanged"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      FrozenColumnCount="2">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="时间" Binding="{Binding CreatedAtText}" Width="78"/>
                    <DataGridTextColumn Header="状态" Binding="{Binding State}" Width="92"/>
                    <DataGridTextColumn Header="进度" Binding="{Binding ProgressText}" Width="210"/>
                    <DataGridTextColumn Header="当前文件" Binding="{Binding CurrentFile}" Width="220"/>
                    <DataGridTextColumn Header="用时" Binding="{Binding DurationText}" Width="78"/>
                    <DataGridTextColumn Header="画廊链接" Binding="{Binding Url}" Width="430"/>
                    <DataGridTextColumn Header="保存位置" Binding="{Binding OutputDirectory}" Width="360"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <Border Grid.Row="5" Background="White" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="8" Padding="13" Margin="0,12,0,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="详细说明：" FontWeight="SemiBold" Margin="0,1,8,0"/>
                <TextBox x:Name="DetailsTextBox" Grid.Column="1" IsReadOnly="True"
                         BorderThickness="0" Padding="0" MinHeight="24" MaxHeight="68"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         Background="Transparent" Text="选中一条任务后，这里会显示详细状态和中文错误说明。"/>
                <Button Grid.Column="2" Content="复制说明" Margin="12,0,0,0" Padding="11,5"
                        MinHeight="30" Click="CopyDetailsButton_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Row="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid>
                <TextBlock x:Name="FooterStatusText" Foreground="{StaticResource SubTextBrush}"
                           Text="准备就绪。第一次使用请确认浏览器中已经登录网站。"/>
                <TextBlock x:Name="CountText" HorizontalAlignment="Right" Foreground="{StaticResource SubTextBrush}"/>
            </Grid>
            <ProgressBar x:Name="ActivityProgressBar" Grid.Row="1" Margin="0,8,0,0" IsIndeterminate="False"/>
        </Grid>
    </Grid>
</Window>
