<Window x:Class="EhGalleryDownloader.BrowserCookieConsentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="浏览器登录导入：安装与使用" Width="760" Height="720" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Background="#F5F7FB">
    <Grid Margin="22">
        <Border Background="White" BorderBrush="#E4E9F2" BorderThickness="1" CornerRadius="16" Padding="28">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Border Width="48" Height="48" Background="#E8F0FF" CornerRadius="14">
                        <TextBlock Text="✓" FontSize="24" FontWeight="Bold" Foreground="#2563EB"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="15,1,0,0">
                        <TextBlock Text="网页登录后，还需要用扩展发送" FontSize="19" FontWeight="SemiBold"/>
                        <TextBlock Text="首次安装一次；以后按第 2、3 步操作即可" FontSize="{DynamicResource FontCaptionSize}"
                                   Foreground="{StaticResource SubTextBrush}" Margin="0,6,0,0"/>
                    </StackPanel>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,20,0,0">
                  <StackPanel Margin="0,0,8,0">
                    <Border Padding="16" Background="#F0F6FF" CornerRadius="10">
                      <StackPanel>
                        <TextBlock Text="1. 首次使用：安装“画廊登录导入”扩展" FontWeight="SemiBold"/>
                        <ComboBox x:Name="BrowserChoiceComboBox" SelectedIndex="0" Margin="0,10,0,8">
                            <ComboBoxItem Content="Google Chrome" Tag="chrome"/>
                            <ComboBoxItem Content="Microsoft Edge" Tag="edge"/>
                        </ComboBox>
                        <TextBlock Text="点击“复制扩展页地址”，粘贴到所选浏览器的地址栏并打开。开启“开发者模式”，点击“加载已解压的扩展程序”，选择下面这个 BrowserExtension 文件夹。"
                                   TextWrapping="Wrap" LineHeight="21"/>
                        <TextBox x:Name="ExtensionPathTextBox" IsReadOnly="True" Margin="0,10,0,8" TextWrapping="Wrap"/>
                        <WrapPanel>
                            <Button Content="复制扩展页地址" Margin="0,0,8,7" Click="CopyExtensionAddressButton_Click"/>
                            <Button Content="打开扩展文件夹" Margin="0,0,8,7" Click="OpenExtensionFolderButton_Click"/>
                            <Button Content="复制文件夹路径" Margin="0,0,0,7" Click="CopyExtensionPathButton_Click"/>
                        </WrapPanel>
                        <TextBlock Text="安装后点击浏览器右上角的拼图图标，把“画廊登录导入”固定到工具栏。软件更新后请在扩展管理页刷新该扩展，并确认版本与随附安装说明一致；如提示新增站点权限，请允许本扩展访问 E-Hentai / ExHentai 后再使用。"
                                   TextWrapping="Wrap" LineHeight="21" Foreground="#526B91"/>
                        <TextBlock x:Name="GuideStatusText" TextWrapping="Wrap" Margin="0,7,0,0" Foreground="#315FCA"/>
                      </StackPanel>
                    </Border>
                    <TextBlock Text="2. 在同一浏览器用户中登录画廊" FontWeight="SemiBold" Margin="0,18,0,7"/>
                    <TextBlock Text="打开并刷新要下载的画廊，确认能看到内容。下载 ExHentai 时，要在 ExHentai 页面操作；只登录论坛或 E-Hentai 不一定有里站访问权限。建议使用普通窗口。"
                               TextWrapping="Wrap" LineHeight="21"/>
                    <TextBlock Text="3. 开始等待，再到浏览器扩展里发送" FontWeight="SemiBold" Margin="0,18,0,7"/>
                    <TextBlock Text="点击下方“开始等待浏览器”，然后回到已登录的画廊网页。点击工具栏的“画廊登录导入”，再点击“发送到下载助手”。软件等待 5 分钟，并显示连接和验证进度。"
                               TextWrapping="Wrap" LineHeight="21"/>
                    <TextBlock Text="仅导入画廊网站的必要登录 Cookie；不读取密码或浏览记录。信息交给本机下载助手后，由软件向画廊网站验证登录。"
                               TextWrapping="Wrap" Foreground="{StaticResource SubTextBrush}" Margin="0,18,0,0" LineHeight="20"/>
                  </StackPanel>
                </ScrollViewer>
                <Grid Grid.Row="2" Margin="0,18,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Button Grid.Column="1" Content="取消" Width="92" Margin="0,0,10,0" IsCancel="True"/>
                    <Button Grid.Column="2" Content="开始等待浏览器" Width="165" Style="{StaticResource PrimaryButton}"
                            IsDefault="True" Click="AllowButton_Click"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
